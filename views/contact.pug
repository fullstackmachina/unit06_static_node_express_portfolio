extends layout.pug

block content

  nav.nav
    a(href='/')
      span &larr;
      |  Back

  article.portfolio-contact
    .inner-wrapper
      .contact-hero.box
        h1 Contact 
        p.contact-intro I'm always happy to connect about full-stack projects, learning opportunities, or ideas that could become useful web experiences.

      .contact-board.box
        .contact-form-panel
          h6 Send a message
          form.contact-form(action='#' method='post' novalidate data-emailjs-public-key='JOHCuwKQWveCpxvh7' data-emailjs-service-id='service_9868auk' data-emailjs-template-id='template_d65qecm')
            .form-field
              label(for='name') Name
              input#name(type='text' name='name' placeholder='Your name' required maxlength='100' data-max-chars='100' aria-describedby='name-error name-count')
              .form-field-meta
                span#name-error.form-error
                span#name-count.form-count
            .form-field
              label(for='email') Email
              input#email(type='email' name='email' placeholder='your.email@example.com' required aria-describedby='email-error')
              span#email-error.form-error
            .form-field
              label(for='subject') Subject
              input#subject(type='text' name='subject' placeholder='Project, opportunity, or hello' required maxlength='150' data-max-chars='150' aria-describedby='subject-error subject-count')
              .form-field-meta
                span#subject-error.form-error
                span#subject-count.form-count
            .form-field
              label(for='message') Message
              textarea#message(name='message' rows='6' placeholder='Tell me a little about what you have in mind...' required maxlength='5000' data-max-chars='5000' aria-describedby='message-error message-count')
              .form-field-meta
                span#message-error.form-error
                span#message-count.form-count 0 / 5000
            button.btn-link.contact-submit(type='submit') Send message
            p.form-status(aria-live='polite')

        aside.contact-main
          h6 Let's connect
          p Whether you want to follow my progress, talk about a project, or share an opportunity, these are the best places to reach me.

          .contact-actions
            a.contact-card(href='https://www.linkedin.com/in/roxanne-perron-97170917b/' target='_blank' rel='noopener noreferrer')
              span.contact-card-label LinkedIn
            a.contact-card(href='https://github.com/fullstackmachina' target='_blank' rel='noopener noreferrer')
              span.contact-card-label GitHub
